# The application listens on loopback unless you explicitly set HOST for trusted-LAN use.
HOST=127.0.0.1
PORT=3000

# Comma-separated browser origins; an explicit leftmost *.domain matches one DNS label only.
# Scheme and port must match. This is not authentication; use only trusted domains.
# Tailscale example (replace the suffix with your own tailnet DNS name):
# TRUSTED_ORIGINS=https://*.tail1234.ts.net,http://*.tail1234.ts.net:3000
TRUSTED_ORIGINS=

# Development Vite origin and the backend target used by frontend/vite.config.ts.
VITE_ORIGIN=http://127.0.0.1:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# The managed ttyd port range and private tmux server namespace.
TTYD_PORT_RANGE_START=7681
TTYD_PORT_RANGE_END=7780
TTYD_TMUX_SOCKET=ttyd-webui
