{
  "name": "ttyd-webui",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./frontend --filter ./server dev",
    "build": "pnpm --filter ./frontend build",
    "start": "pnpm --filter ./server start",
    "typecheck": "pnpm --filter ./frontend typecheck",
    "test:backend": "node --test tests/backend/*.test.cjs",
    "verify": "pnpm build"
  }
}
